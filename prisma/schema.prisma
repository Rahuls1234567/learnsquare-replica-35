// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Enrolment {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  mobileNumber String
  email        String
  course       String
  program      String
  branch       String
  yearOfStudy  String
  semester     String
  createdAt    DateTime @default(now())
}

model TrainingRequest {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  whatsappNo  String
  email       String
  collegeName String
  message     String
  createdAt   DateTime @default(now())
}

model Syntaxwork {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  whatsappNo String
  email      String
  message    String
  createdAt  DateTime @default(now())
}

model Aicas {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  whatsappNo  String
  email       String
  collegeName String
  city        String
  message     String
  createdAt   DateTime @default(now())
}

model TestPrepPro {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  whatsappNo  String
  email       String
  collegeName String
  message     String
  createdAt   DateTime @default(now())
}

model Contact {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  whatsappNo  String
  email       String
  collegeName String
  message     String
  createdAt   DateTime @default(now())
}

model User {
  id            Int      @id @default(autoincrement())
  name          String?
  email         String   @unique
  password      String
  phoneNumber   String?
  collegeCourse String?
  branch        String?
  year          String?
  city          String?
  address       String?  @db.Text
  createdAt     DateTime @default(now())
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
model WebsiteContent {
  id          Int      @id @default(autoincrement())
  contentKey  String   @unique
  pageName    String
  htmlContent String   @db.Text
  updatedAt   DateTime @updatedAt
}

model SemesterPrep {
  id         Int      @id @default(autoincrement())
  name       String
  university String
  college    String
  email      String
  password   String
  mobile     String
  createdAt  DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   // e.g. "II Year CSE Student" or "Final Year Student, SVIT"
  text      String   @db.Text
  image     String?  // Optional image path/url for semester-prep
  rating    Int?     @default(5) // For collaborations section
  page      String   // "home" or "semester-prep"
  createdAt DateTime @default(now())
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  image     String?
  isActive  Boolean  @default(true)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
